# ==============================================================================
# GARAA B2B IDENTITY & DOCUMENT VERIFICATION PLATFORM
# ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (Default Zero-Config SQLite):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL:
# DATABASE_URL="postgresql://garaa_user:garaa_secure_pass@localhost:5432/garaa_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# JWT Signing Secret (Must be >= 32 characters in production)
JWT_SECRET="garaa_production_jwt_signing_secret_super_secure_key_2026_9941a"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Private filesystem storage path (Tenant files are isolated within tenant subdirectories)
STORAGE_PATH="./uploads"

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY VERIFICATION PROVIDER INTEGRATION FLAGS
# Note: External APIs remain DISABLED until authorized production credentials are supplied.
# Engine gracefully reports status as NOT_CHECKED when integrations are disabled.
# ------------------------------------------------------------------------------
ENABLE_EXTERNAL_GOV_REGISTRY=false
ENABLE_EXTERNAL_ACADEMIC_REGISTRY=false
ENABLE_EXTERNAL_TAX_REGISTRY=false

# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:5173"
